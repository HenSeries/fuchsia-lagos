		gpio-controller;
		#gpio-cells = <0x02>;
		gpio-ranges = <0x31 0x00 0x00 0xba>;
		interrupt-controller;
		#interrupt-cells = <0x04>;
		mediatek,eint = <0x32>;
		phandle = <0x31>;

		aud_clk_mosi_off: aud_clk_mosi_off {
