			node-55 = "__SSPM_GPU_APU_SSC_CNT__", "GPU_0_R,GPU_0_W,APU_0_R,APU_0_W,GPU_1_R,", "GPU_1_W,APU_1_R,APU_1_W";
			phandle = <0x167>;
		};
