		mmc0_pins_default: mmc0default {
			phandle = <0x60>;

			pins_cmd_dat {
				pinmux = <0x7b01 0x8001 0x7d01 0x8401 0x7e01 0x8101 0x7f01 0x8201 0x7a01>;
				input-enable;
				drive-strength = <0x04>;
				bias-pull-up = <0x65>;
				input-schmitt-enable = <0x01>;
			};

			pins_clk {
				input-enable;
				pinmux = <0x7c01>;
				drive-strength = <0x04>;
				bias-pull-down = <0x66>;
				input-schmitt-enable = <0x01>;
			};

			pins_ds {
				input-enable;
				pinmux = <0x8301>;
				drive-strength = <0x04>;
				bias-pull-down = <0x66>;
				input-schmitt-enable = <0x01>;
			};

			pins_rst {
				input-enable;
				pinmux = <0x8501>;
				drive-strength = <0x04>;
				bias-pull-up = <0x65>;
				input-schmitt-enable = <0x01>;
			};
		};

		mmc0_pins_uhs: mmc0@0 {
			phandle = <0x61>;

			pins_cmd_dat {
				pinmux = <0x7b01 0x8001 0x7d01 0x8401 0x7e01 0x8101 0x7f01 0x8201 0x7a01>;
				input-enable;
				drive-strength = <0x04>;
				bias-pull-up = <0x65>;
				input-schmitt-enable = <0x01>;
