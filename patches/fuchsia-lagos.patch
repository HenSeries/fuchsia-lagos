 };
 
+// [fuchsia-lagos] MediaTek TOPRGU watchdog (mt6768 / mt6589 family), as on the
+// Motorola Moto G06 ("lagos", MT6768). Register map from Linux drivers/watchdog/mtk_wdt.c:
+//   WDT_MODE (+0x00): bit0 = WDT_MODE_EN; writes must carry WDT_MODE_KEY (0x22 in
+//                     bits [31:24]) or the hardware ignores them. The key is
+//                     write-only and does not read back.
+//   WDT_RST  (+0x08): writing WDT_RST_RELOAD (0x1971) reloads (pets) the counter.
+// Without this entry the shim never sees the WDT, Zircon never pets it, and the
+// MediaTek bootloader-armed watchdog resets the SoC ~20 s into boot (the bootloop
+// seen in fuchsia-lagos attempts 1 and 2). See fuchsia-lagos/docs/10.
+struct MediatekToprguWatchdog {
+  static constexpr auto kCompatibleDevices = std::to_array<std::string_view>(
+      {"mediatek,mt6768-wdt", "mediatek,mt6589-wdt", "mediatek,toprgu"});
+
+  static constexpr uint32_t kModeOffset = 0x0;
+  static constexpr uint32_t kRestartOffset = 0x8;
+  static constexpr uint32_t kModeKey = 0x22000000;
+  static constexpr uint32_t kModeEnable = 0x1;
+  static constexpr uint32_t kRestartReload = 0x1971;
+
+  struct DecodedNode {
+    uint64_t addr;
+    uint64_t size;
+  };
+
+  template <typename MmioHelper>
+  static std::optional<zbi_dcfg_generic32_watchdog_t> MaybeCreate(
+      const devicetree::PropertyDecoder& decoder,
+      const DevicetreeBootShimMmioObserver* mmio_observer) {
+    std::optional<DecodedNode> decoded_node = DecodeNode(decoder);
+    if (!decoded_node) {
+      return std::nullopt;
+    }
+
+    (*mmio_observer)(MmioRange{
+        .address = decoded_node->addr,
+        .size = static_cast<size_t>(decoded_node->size),
+    });
+
+    return zbi_dcfg_generic32_watchdog_t{
+        // Reload the counter: write the reload magic to WDT_RST.
+        .pet_action =
+            {
+                .addr = decoded_node->addr + kRestartOffset,
+                .clr_mask = 0xffffffff,
+                .set_mask = kRestartReload,
+            },
+        // Used by GenericWatchdogItemBase to DETECT whether the WDT is enabled by
+        // reading WDT_MODE and testing set_mask. The key does not read back, so
+        // detection must test only the EN bit. (A write through this action would
+        // lack the key and be ignored by hardware, which is fine: we never want
+        // to re-enable it.)
+        .enable_action =
+            {
+                .addr = decoded_node->addr + kModeOffset,
+                .clr_mask = kModeEnable,
+                .set_mask = kModeEnable,
+            },
+        // Disable: write key with EN (and every other mode bit) cleared.
+        .disable_action =
+            {
+                .addr = decoded_node->addr + kModeOffset,
+                .clr_mask = 0xffffffff,
+                .set_mask = kModeKey,
+            },
+        // The bootloader-armed timeout is ~20 s; pet well inside that.
+        .watchdog_period_nsec = zx::sec(5).to_nsecs(),
+        .flags = 0,
+    };
+  }
+
+  static std::optional<DecodedNode> DecodeNode(const devicetree::PropertyDecoder& decoder) {
+    auto [reg_prop, compatible_prop] = decoder.FindProperties("reg", "compatible");
+    (void)compatible_prop;  // only `reg` is needed; keep the binding warning-free
+    if (!reg_prop) {
+      return std::nullopt;
+    }
+
+    auto reg = reg_prop->AsReg(decoder);
+    if (!reg || reg->size() == 0) {
+      return std::nullopt;
+    }
+
+    auto base_reg = (*reg)[0];
+    std::optional<uint64_t> base_addr = base_reg.address();
+    std::optional<uint64_t> base_size = base_reg.size();
+    if (!base_addr || !base_size) {
+      return std::nullopt;
+    }
+
+    return DecodedNode{
+        .addr = *base_addr,
+        .size = *base_size,
+    };
+  }
+};
+
