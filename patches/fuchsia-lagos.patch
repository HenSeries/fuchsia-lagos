+#if defined(__aarch64__)
+// [fuchsia-lagos] Framebuffer progress bar for the Moto G06 (no UART tap).
+// LK's framebuffer: 0x781b0000, BGRA8888, 720x1640, three frame slots with
+// different pitches (the visible overlay layer is unknown, so paint all three).
+// Physboot reserves this bank (kTestRamReserve), so the PMM never allocates
+// it and the physmap still covers it. See fuchsia-lagos/docs/14.
+namespace {
+constexpr uint64_t kLagosFb = 0x781b0000;
+struct LagosFrame {
+  uint64_t offset;
+  uint32_t pitch;
+};
+constexpr LagosFrame kLagosFrames[] = {{0, 2944}, {0x4ac000, 2880}, {0x958000, 2944}};
+constexpr uint32_t kLagosRows = 1640;
+constexpr uint32_t kLagosCols = 720;
+
+void LagosFillRows(uint32_t row0, uint32_t row1, uint32_t bgra) {
+  if (gPhysHandoff == nullptr) {
+    return;
+  }
+  for (const LagosFrame& f : kLagosFrames) {
+    const uintptr_t base = gPhysHandoff->physmap_base + kLagosFb + f.offset;
+    for (uint32_t r = row0; r < row1 && r < kLagosRows; ++r) {
+      auto* row = reinterpret_cast<volatile uint32_t*>(base + uint64_t{r} * f.pitch);
+      for (uint32_t c = 0; c < kLagosCols; ++c) {
+        row[c] = bgra;
+      }
+    }
+    if (row1 > row0) {
+      arch_clean_cache_range(static_cast<vaddr_t>(base + uint64_t{row0} * f.pitch),
+                             static_cast<size_t>(row1 - row0) * f.pitch);
+    }
+  }
+}
+
+// Band k (1-based) occupies rows [(k-1)*160, k*160): a stage counter you can
+// read off the screen.
+void LagosBand(int k, uint32_t bgra) {
+  LagosFillRows(static_cast<uint32_t>(k - 1) * 160, static_cast<uint32_t>(k) * 160, bgra);
+}
+
+// Heartbeat: the bottom strip alternates white/black every 500 ms. It only
+// blinks if the scheduler, the arch timer and GIC interrupts all work.
+int LagosHeartbeat(void*) {
+  for (bool on = true;; on = !on) {
+    LagosFillRows(1440, kLagosRows, on ? 0xFFFFFFFF : 0xFF000000);
+    Thread::Current::SleepRelative(ZX_MSEC(500));
+  }
+  return 0;
+}
+}  // namespace
