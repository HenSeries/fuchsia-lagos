+// [fuchsia-lagos] Per-core progress markers for the Moto G06 (no UART tap).
+// Paint a 10x10 square for this core into LK's framebuffer at its PHYSICAL
+// address: MMU off (Device memory), or MMU on through the TTBR0 identity map
+// (each row is cleaned to PoC). Row 480, column core*90 + stage*12, core = MPIDR.Aff1 (MT6768 is DynamIQ). All three
+// frame slots. Clobbers x10-x17 only (x0 carries the PSCI context and must
+// survive). Colour is in w11. See fuchsia-lagos/docs/15.
+.macro LAGOS_MARK_FRAME base, pitch
+  movz x12, #((\base) & 0xffff)
+  movk x12, #(((\base) >> 16) & 0xffff), lsl #16
+  add x12, x12, x10
+  mov x13, #(\pitch)
+  mov x14, #480
+  madd x12, x14, x13, x12
+  mov x15, #10
+1:
+  mov x16, #10
+  mov x17, x12
+2:
+  str w11, [x17], #4
+  subs x16, x16, #1
+  b.ne 2b
+  dc civac, x12
+  add x17, x12, #36
+  dc civac, x17
+  add x12, x12, x13
+  subs x15, x15, #1
+  b.ne 1b
+.endm
+
+.macro LAGOS_CPU_MARK stage
+  mrs x10, mpidr_el1
+  ubfx x10, x10, #8, #8
+  mov x14, #90
+  mul x10, x10, x14
+  add x10, x10, #((\stage) * 12)
+  lsl x10, x10, #2
+  LAGOS_MARK_FRAME 0x781b0000, 2944
+  LAGOS_MARK_FRAME 0x7865c000, 2880
+  LAGOS_MARK_FRAME 0x78b08000, 2944
+  dsb sy
+.endm
