diff --git a/src/devices/board/drivers/qemu-arm64/lagos-usb.cc b/src/devices/board/drivers/qemu-arm64/lagos-usb.cc
new file mode 100644
index 00000000000..88f6a3ef712
--- /dev/null
+++ b/src/devices/board/drivers/qemu-arm64/lagos-usb.cc
@@ -0,0 +1,64 @@
+// Copyright 2026 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// [fuchsia-lagos] The Moto G06 (MT6768) boots with the arm64 board config,
+// so this qemu-arm64 board driver is the one that binds. Until lagos has its
+// own (devicetree) board driver, it also publishes the MediaTek MUSB USB
+// device controller for src/devices/usb/drivers/mt-musb. See
+// fuchsia-lagos/docs/17.
+
+#include <fidl/fuchsia.hardware.platform.bus/cpp/driver/fidl.h>
+#include <fidl/fuchsia.hardware.platform.bus/cpp/fidl.h>
+#include <lib/ddk/debug.h>
+#include <zircon/status.h>
+
+#include "qemu-bus.h"
+
+namespace board_qemu_arm64 {
+namespace fpbus = fuchsia_hardware_platform_bus;
+
+namespace {
+constexpr uint32_t kMediatekVid = 0x07;        // fuchsia.mediatek.platform MEDIATEK
+constexpr uint32_t kMusbPeripheralDid = 0x01;  // MUSB_PERIPHERAL
+constexpr uint32_t kMt6768Pid = 0x01;          // MT6768
+constexpr uint32_t kUsbIrq = 32 + 0x61;        // GIC SPI 97, level high (stock DT)
+}  // namespace
+
+zx_status_t QemuArm64::LagosUsbInit() {
+  static const std::vector<fpbus::Mmio> kMmios{
+      {{.base = 0x11200000, .length = 0x10000}},  // MUSB core
+      {{.base = 0x11cc0000, .length = 0x1000}},   // U2 PHY (port 0 at +0x800)
+      {{.base = 0x10001000, .length = 0x1000}},   // infracfg_ao (USB clock gate)
+      {{.base = 0x10000000, .length = 0x1000}},   // topckgen (usb_top_sel mux)
+  };
+  static const std::vector<fpbus::Irq> kIrqs{
+      {{
+          .irq = fpbus::IrqSpec::WithIrq(kUsbIrq),
+          .mode = fpbus::ZirconInterruptMode::kLevelHigh,
+      }},
+  };
+  fpbus::Node dev;
+  dev.name() = "mt-musb";
+  dev.vid() = kMediatekVid;
+  dev.pid() = kMt6768Pid;
+  dev.did() = kMusbPeripheralDid;
+  dev.mmio() = kMmios;
+  dev.irq() = kIrqs;
+
+  fidl::Arena<> fidl_arena;
+  fdf::Arena arena('MUSB');
+  auto result = pbus_.buffer(arena)->NodeAdd(fidl::ToWire(fidl_arena, dev));
+  if (!result.ok()) {
+    zxlogf(ERROR, "lagos: NodeAdd(mt-musb) request failed: %s", result.FormatDescription().data());
+    return result.status();
+  }
+  if (result->is_error()) {
+    zxlogf(ERROR, "lagos: NodeAdd(mt-musb) failed: %s", zx_status_get_string(result->error_value()));
+    return result->error_value();
+  }
+  zxlogf(INFO, "lagos: published mt-musb");
+  return ZX_OK;
+}
+
+}  // namespace board_qemu_arm64
