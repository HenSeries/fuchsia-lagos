+#ifndef SRC_DEVICES_USB_DRIVERS_MT_MUSB_MT_MUSB_H_
+#define SRC_DEVICES_USB_DRIVERS_MT_MUSB_MT_MUSB_H_
+
+// [fuchsia-lagos] USB device-mode (DCI) driver for the MediaTek MUSB controller
+// of the MT6768 (Moto G06 "lagos"). Programmed I/O only: every byte goes
+// through the endpoint FIFOs, so no DMA, BTI or 32-bit address limits.
+// Register-level behaviour follows the old Fuchsia MT8167 driver
+// (mt-musb-peripheral, 2021) and MediaTek's mt6768 usb20 sources; see
+// fuchsia-lagos/docs/17.
+
+#include <fidl/fuchsia.hardware.usb.dci/cpp/fidl.h>
