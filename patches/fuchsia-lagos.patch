--- a/zircon/kernel/phys/lib/boot-shim/include/lib/boot-shim/watchdog.h
+++ b/zircon/kernel/phys/lib/boot-shim/include/lib/boot-shim/watchdog.h
@@ -162,8 +162,104 @@ struct QualcomMsmWatchdog {
