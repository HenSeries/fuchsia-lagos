--- a/build/bazel/templates/template.bazelrc
+++ b/build/bazel/templates/template.bazelrc
@@ -8,6 +8,21 @@
 # to improve hermeticity and caching.
 build --incompatible_strict_action_env=true
 
+# [fuchsia-lagos LOCAL PATCH] Bazel 8.x sandbox-directory REUSE corrupts Rustc
+# actions on this host (Arch): sandboxed `rustc` exits 1 with no stderr. The same
+# action succeeds with --sandbox_debug, which (per Bazel docs) disables sandbox
+# reuse. So disable reuse and KEEP the sandbox (a blanket --spawn_strategy=local
+# instead breaks the assembly copy of GN board-input-bundle dirs, and
+# --strategy=Rustc=local does not actually reroute these actions). Local dev only.
+# See fuchsia-lagos/docs/06-build-notes.md.
+build --noreuse_sandbox_directories
+# [fuchsia-lagos LOCAL PATCH] Cap Bazel local concurrency. This host (22 GB RAM, no
+# swap) OOM-kills sandboxed actions when ninja fans out many bazel_actions at once
+# (symptom: "rustc exit 1 no stderr" and "(Killed)"). --jobs only throttles Bazel,
+# not ninja's C++ compiles, so Zircon still builds fast. Proven: jobs=4 builds the
+# host tools cleanly where the default concurrency kills them.
+build --jobs=4
+
 # Do not create runfiles symlink forests for external repositories
 # under .runfiles/_main/external/repo in addition to .runfiles/repo.
 #
