+// ============================== Endpoint ==============================
+
+Endpoint::~Endpoint() {
+  std::lock_guard<std::mutex> lock(vmo_lock_);
+  for (auto& [id, m] : vmos_) {
+    zx::vmar::root_self()->unmap(m.addr, m.size);
+  }
+}
+
+void Endpoint::Connect(async_dispatcher_t* dispatcher,
+                       fidl::ServerEnd<fendpoint::Endpoint> server_end) {
+  std::lock_guard<std::mutex> lock(binding_lock_);
+  binding_.emplace(fidl::BindServer(
+      dispatcher, std::move(server_end), this,
+      [](Endpoint* ep, fidl::UnbindInfo, fidl::ServerEnd<fendpoint::Endpoint>) {
+        std::lock_guard<std::mutex> lock(ep->binding_lock_);
+        ep->binding_.reset();
+      }));
+}
+
+void Endpoint::GetInfo(GetInfoCompleter::Sync& completer) {
+  completer.Reply(fit::as_error(ZX_ERR_NOT_SUPPORTED));
+}
+
+void Endpoint::RegisterVmos(RegisterVmosRequest& request, RegisterVmosCompleter::Sync& completer) {
+  std::vector<fendpoint::VmoHandle> out;
+  std::lock_guard<std::mutex> lock(vmo_lock_);
+  for (const auto& info : request.vmo_ids()) {
+    if (!info.id() || !info.size()) {
+      continue;
+    }
+    const uint64_t id = *info.id();
+    const size_t size = *info.size();
+    if (vmos_.contains(id)) {
+      fdf::error("ep {:#x}: VMO {} already registered", ep_num_ | (is_in_ ? 0x80 : 0), id);
+      continue;
+    }
+    MappedVmo m;
+    if (zx_status_t s = zx::vmo::create(size, 0, &m.vmo); s != ZX_OK) {
+      fdf::error("vmo create: {}", zx_status_get_string(s));
+      continue;
+    }
+    if (zx_status_t s = zx::vmar::root_self()->map(ZX_VM_PERM_READ | ZX_VM_PERM_WRITE, 0, m.vmo,
+                                                   0, size, &m.addr);
+        s != ZX_OK) {
+      fdf::error("vmo map: {}", zx_status_get_string(s));
+      continue;
+    }
+    m.size = size;
+    zx::vmo dup;
+    if (zx_status_t s = m.vmo.duplicate(ZX_RIGHT_SAME_RIGHTS, &dup); s != ZX_OK) {
+      zx::vmar::root_self()->unmap(m.addr, m.size);
+      continue;
+    }
+    fendpoint::VmoHandle handle;
+    handle.id(id);
+    handle.vmo(std::move(dup));
+    out.push_back(std::move(handle));
+    vmos_.emplace(id, std::move(m));
+  }
+  completer.Reply({std::move(out)});
+}
+
+void Endpoint::UnregisterVmos(UnregisterVmosRequest& request,
+                              UnregisterVmosCompleter::Sync& completer) {
+  std::vector<uint64_t> failed;
+  std::vector<zx_status_t> errors;
+  std::lock_guard<std::mutex> lock(vmo_lock_);
+  for (uint64_t id : request.vmo_ids()) {
+    auto it = vmos_.find(id);
+    if (it == vmos_.end()) {
+      failed.push_back(id);
+      errors.push_back(ZX_ERR_NOT_FOUND);
+      continue;
+    }
+    zx::vmar::root_self()->unmap(it->second.addr, it->second.size);
+    vmos_.erase(it);
+  }
+  completer.Reply({std::move(failed), std::move(errors)});
+}
+
+void Endpoint::QueueRequests(QueueRequestsRequest& request,
+                             QueueRequestsCompleter::Sync& completer) {
+  {
+    std::lock_guard<std::mutex> lock(musb_->hw_lock_);
+    for (auto& req : request.req()) {
+      queued.push(std::move(req));
+    }
+  }
+  musb_->KickEndpoint(this);
+}
+
+void Endpoint::CancelAll(CancelAllCompleter::Sync& completer) {
+  musb_->CancelEndpoint(this);
+  completer.Reply(fit::ok());
+}
+
+void Endpoint::FailAll(zx_status_t status) {
+  std::vector<frequest::Request> reqs;
+  {
+    std::lock_guard<std::mutex> lock(musb_->hw_lock_);
+    if (current) {
+      reqs.push_back(std::move(*current));
+      current.reset();
+    }
+    while (!queued.empty()) {
+      reqs.push_back(std::move(queued.front()));
+      queued.pop();
+    }
+    rx_waiting = false;
+    zlp_pending = false;
+  }
+  for (auto& r : reqs) {
+    Complete(std::move(r), status, 0);
+  }
+}
+
+size_t Endpoint::RequestLength(const frequest::Request& req) {
+  size_t len = 0;
+  if (req.data()) {
+    for (const auto& region : *req.data()) {
+      len += region.size().value_or(0);
+    }
+  }
+  return len;
+}
+
+bool Endpoint::Gather(const frequest::Request& req, std::vector<uint8_t>& out) {
+  out.clear();
+  if (!req.data()) {
+    return true;
+  }
+  std::lock_guard<std::mutex> lock(vmo_lock_);
+  for (const auto& region : *req.data()) {
+    const size_t size = region.size().value_or(0);
+    const size_t off = region.offset().value_or(0);
+    if (size == 0 || !region.buffer()) {
+      continue;
+    }
+    const auto& b = *region.buffer();
+    if (b.Which() == frequest::Buffer::Tag::kVmoId) {
+      auto it = vmos_.find(b.vmo_id().value());
+      if (it == vmos_.end() || off + size > it->second.size) {
+        return false;
+      }
+      const auto* p = reinterpret_cast<const uint8_t*>(it->second.addr + off);
+      out.insert(out.end(), p, p + size);
+    } else if (b.Which() == frequest::Buffer::Tag::kData) {
+      const auto& d = b.data().value();
+      if (off + size > d.size()) {
+        return false;
+      }
+      out.insert(out.end(), d.begin() + static_cast<ptrdiff_t>(off),
+                 d.begin() + static_cast<ptrdiff_t>(off + size));
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool Endpoint::Scatter(frequest::Request& req, const std::vector<uint8_t>& in) {
+  if (!req.data()) {
+    return in.empty();
+  }
+  size_t pos = 0;
+  std::lock_guard<std::mutex> lock(vmo_lock_);
+  for (auto& region : *req.data()) {
+    if (pos >= in.size()) {
+      break;
+    }
+    const size_t size = region.size().value_or(0);
+    const size_t off = region.offset().value_or(0);
+    const size_t n = std::min(size, in.size() - pos);
+    if (n == 0 || !region.buffer()) {
+      continue;
+    }
+    auto& b = *region.buffer();
+    if (b.Which() == frequest::Buffer::Tag::kVmoId) {
+      auto it = vmos_.find(b.vmo_id().value());
+      if (it == vmos_.end() || off + n > it->second.size) {
+        return false;
+      }
+      memcpy(reinterpret_cast<uint8_t*>(it->second.addr + off), in.data() + pos, n);
+    } else if (b.Which() == frequest::Buffer::Tag::kData) {
+      auto& d = b.data().value();
+      if (d.size() < off + n) {
+        d.resize(off + n);
+      }
+      memcpy(d.data() + off, in.data() + pos, n);
+    } else {
+      return false;
+    }
+    pos += n;
+  }
+  return true;
+}
+
+void Endpoint::Complete(frequest::Request req, zx_status_t status, size_t actual) {
+  std::vector<fendpoint::Completion> completions;
+  fendpoint::Completion completion;
+  completion.request(std::move(req));
+  completion.status(status);
+  completion.transfer_size(actual);
+  completions.push_back(std::move(completion));
+  std::lock_guard<std::mutex> lock(binding_lock_);
+  if (!binding_) {
+    return;
+  }
+  auto result = fidl::SendEvent(*binding_)->OnCompletion(std::move(completions));
+  if (result.is_error()) {
+    fdf::error("ep {:#x}: OnCompletion: {}", ep_num_ | (is_in_ ? 0x80 : 0),
+               result.error_value().FormatDescription());
+  }
+}
+
+// ============================== MtMusb ==============================
+
+zx::result<> MtMusb::Start(fdf::DriverContext context) {
+  auto incoming = std::shared_ptr<fdf::Namespace>(context.take_incoming());
+  zx::result pdev_client = incoming->Connect<fuchsia_hardware_platform_device::Service::Device>();
+  if (pdev_client.is_error()) {
+    fdf::error("connect pdev: {}", pdev_client);
+    return pdev_client.take_error();
+  }
+  fdf::PDev pdev{std::move(*pdev_client)};
+
+  for (uint32_t i = 0; i < 4; i++) {
+    zx::result mmio = pdev.MapMmio(i);
+    if (mmio.is_error()) {
+      fdf::error("map mmio {}: {}", i, mmio);
+      return mmio.take_error();
+    }
+    std::optional<fdf::MmioBuffer>* slot[] = {&usb_mmio_, &phy_mmio_, &infra_mmio_, &topck_mmio_};
+    slot[i]->emplace(std::move(*mmio));
+  }
+  zx::result irq = pdev.GetInterrupt(0, 0);
+  if (irq.is_error()) {
+    fdf::error("get interrupt: {}", irq);
+    return irq.take_error();
+  }
+  irq_ = std::move(*irq);
+
+  // Clocks first: reading a gated MediaTek peripheral can stall the bus.
+  InitClocks();
+  fdf::info("mt-musb: HWVERS {:#x} EPINFO {:#x} RAMINFO {:#x} POWER {:#x} DEVCTL {:#x}",
+            usb().Read16(kHwVers), usb().Read8(kEpInfo), usb().Read8(kRamInfo),
+            usb().Read8(kPower), usb().Read8(kDevCtl));
+
+  for (uint8_t i = 1; i < kNumEps; i++) {
+    in_eps_[i].emplace(this, i, true);
+    out_eps_[i].emplace(this, i, false);
+  }
+
+  zx::result irq_disp = fdf::SynchronizedDispatcher::Create(
+      fdf::SynchronizedDispatcher::Options::kAllowSyncCalls, "mt-musb-irq",
+      [this](fdf_dispatcher_t*) { irq_thread_stopped_.Signal(); });
+  if (irq_disp.is_error()) {
+    return irq_disp.take_error();
+  }
+  irq_dispatcher_ = std::move(*irq_disp);
+
+  zx::result result = outgoing()->AddService<fdci::UsbDciService>(fdci::UsbDciService::InstanceHandler({
+      .device = bindings_.CreateHandler(this, dispatcher(), fidl::kIgnoreBindingClosure),
+  }));
+  if (result.is_error()) {
+    fdf::error("add service: {}", result);
+    return result.take_error();
+  }
+
+  std::vector props{
+      fdf::MakeProperty2(bind_fuchsia::PLATFORM_DEV_VID,
+                         bind_fuchsia_mediatek_platform::BIND_PLATFORM_DEV_VID_MEDIATEK),
+      fdf::MakeProperty2(bind_fuchsia::PLATFORM_DEV_DID,
+                         bind_fuchsia_mediatek_platform::BIND_PLATFORM_DEV_DID_MUSB_PERIPHERAL),
+      fdf::MakeProperty2(bind_fuchsia::SERVICE, "fuchsia.hardware.usb.dci.UsbDciService"),
+  };
+  std::vector offers = {fdf::MakeOffer2<fdci::UsbDciService>()};
+  // The child must not reuse the driver/pdev name "mt-musb": the parent node is
+  // already named that, and two driver components with the same name in the
+  // boot-drivers collection make component_manager reject the UsbDciService
+  // offer as a dependency cycle (attempt 26, fuchsia-lagos/docs/17).
+  zx::result child = AddChild("mt-musb-dci", props, offers);
+  if (child.is_error()) {
+    fdf::error("add child: {}", child);
+    return child.take_error();
+  }
+  child_.Bind(std::move(*child));
+  fdf::info("mt-musb: started, waiting for usb-peripheral");
+  return zx::ok();
+}
+
+void MtMusb::Stop(fdf::StopCompleter completer) {
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    if (usb_mmio_) {
+      usb().Write8(0, kPower);  // drop the D+ pull-up
+    }
+    running_ = false;
+  }
+  irq_.destroy();
+  if (irq_dispatcher_.get()) {
+    irq_dispatcher_.ShutdownAsync();
+    irq_thread_stopped_.Wait();
+  }
+  completer(zx::ok());
+}
+
+void MtMusb::InitClocks() {
+  // CLK_IFR_ICUSB and CLK_TOP_USB_TOP_SEL (parent univpll3_d4); idempotent.
+  auto& infra = *infra_mmio_;
+  auto& top = *topck_mmio_;
+  const uint32_t cg = infra.Read32(kInfraCg0Sta);
+  const uint32_t cfg5 = top.Read32(kTopClkCfg5);
+  infra.Write32(kIcUsbBit, kInfraCg0Clr);
+  if ((cfg5 & (1u << 23)) || !(cfg5 & (1u << 16))) {
+    top.Write32((1u << 23) | (1u << 16), kTopClkCfg5Clr);
+    top.Write32(1u << 16, kTopClkCfg5Set);
+    top.Write32(1u << 22, kTopClkCfgUpdate);
+  }
+  zx::nanosleep(zx::deadline_after(zx::msec(10)));
+  fdf::info("mt-musb: clocks CG0 {:#x}->{:#x} CLK_CFG_5 {:#x}->{:#x}", cg,
+            infra.Read32(kInfraCg0Sta), cfg5, top.Read32(kTopClkCfg5));
+}
+
+void MtMusb::InitPhy() {
+  // MediaTek mt6768 usb_phy_recover() + set_usb_phy_mode(device), see docs/17.
+  auto& p = phy();
+  auto clr = [&p](uint32_t off, uint32_t bits) { p.Write32(p.Read32(off) & ~bits, off); };
+  auto set = [&p](uint32_t off, uint32_t bits) { p.Write32(p.Read32(off) | bits, off); };
+  zx::nanosleep(zx::deadline_after(zx::usec(50)));
+  clr(kUsbPhyAcr3, 1u << 12);                    // PUPD_BIST_EN
+  clr(kU2PhyDtm0, 1u << 26);                     // FORCE_UART_EN
+  clr(kU2PhyDtm1, 1u << 16);                     // RG_UART_EN
+  clr(kU2PhyAcr4, (1u << 9) | (1u << 8));        // GPIO_CTL, GPIO_MODE
+  clr(kU2PhyDtm0, 1u << 18);                     // FORCE_SUSPENDM
+  clr(kU2PhyDtm0, (1u << 7) | (1u << 6) | (3u << 4) | (1u << 2) | (0xfu << 10));
+  clr(kU2PhyDtm0, (1u << 20) | (1u << 21) | (1u << 19) | (1u << 17) | (1u << 23));
+  clr(kUsbPhyAcr6, 1u << 23);                    // BC11_SW_EN
+  set(kUsbPhyAcr6, 1u << 20);                    // OTG_VBUSCMP_EN
+  p.Write32((p.Read32(kUsbPhyAcr6) & ~(0xffu << 24)) | (0x40u << 24), kUsbPhyAcr6);  // PHY_REV
+  zx::nanosleep(zx::deadline_after(zx::usec(800)));
+  // Device role with VBUS/session forced valid (no charger/extcon driver).
+  clr(kU2PhyDtm1, 1u << 4);
+  set(kU2PhyDtm1, 0x2f);
+  set(kU2PhyDtm1, 0x3f00);
+  // Tuning from the stock devicetree; slew rate default (no frequency meter).
+  p.Write32((p.Read32(kUsbPhyAcr5) & ~(7u << 12)) | (4u << 12), kUsbPhyAcr5);
+  p.Write32((p.Read32(kUsbPhyAcr6) & ~(0xfu << 4)) | (7u << 4), kUsbPhyAcr6);
+  p.Write32((p.Read32(kUsbPhyAcr1) & ~((7u << 12) | (7u << 8))) | (7u << 12) | (7u << 8),
+            kUsbPhyAcr1);
+  fdf::info("mt-musb: PHY ACR6 {:#x} DTM0 {:#x} DTM1 {:#x}", p.Read32(kUsbPhyAcr6),
+            p.Read32(kU2PhyDtm0), p.Read32(kU2PhyDtm1));
+}
+
+void MtMusb::SelectEp(uint8_t ep_num) { usb().Write8(ep_num, kIndex); }
+
+void MtMusb::InitCore() {
+  auto& u = usb();
+  u.Write8(0, kPower);
+  u.Write8(0, kFaddr);
+  u.Write8(kPowerReset, kPower);
+  zx::nanosleep(zx::deadline_after(zx::usec(10)));
+  u.Write8(0, kPower);
+  zx::nanosleep(zx::deadline_after(zx::usec(100)));
+  u.Write8(0x80, kDevCtl);  // B-device
+
+  u.Write8(0, kIntrUsbE);
+  u.Write16(0, kIntrTxE);
+  u.Write16(0, kIntrRxE);
+  u.Write16(0xffff, kIntrRx);
+  u.Write16(0xffff, kIntrTx);
+  u.Write8(0xef, kIntrUsb);
+  u.Write16(0xffff, kTxTogEn);
+  u.Write16(0xffff, kRxTogEn);
+
+  // FIFO RAM layout: ep0 uses the first 64 bytes, then one 512-byte FIFO per
+  // direction for ep1..kNumEps-1 (5 KB of the 8 KB).
+  uint16_t addr = kEp0MaxPacket / 8;
+  for (uint8_t i = 1; i < kNumEps; i++) {
+    SelectEp(i);
+    u.Write16(addr, kTxFifoAdd);
+    u.Write8(FifoSizeCode(kFifoBytes), kTxFifoSz);
+    addr = static_cast<uint16_t>(addr + kFifoBytes / 8);
+    u.Write16(addr, kRxFifoAdd);
+    u.Write8(FifoSizeCode(kFifoBytes), kRxFifoSz);
+    addr = static_cast<uint16_t>(addr + kFifoBytes / 8);
+  }
+  SelectEp(0);
+
+  u.Write16(0x0001, kIntrTxE);  // ep0
+  u.Write8(kUsbIntReset | kUsbIntDiscon | kUsbIntSuspend | kUsbIntResume, kIntrUsbE);
+  u.Write32(kL1Tx | kL1Rx | kL1UsbCom, kL1IntM);
+  ep0_state_ = Ep0State::kIdle;
+  pending_address_.reset();
+  // Soft-connect: the host sees the D+ pull-up and starts enumerating.
+  u.Write8(kPowerEnSuspend | kPowerHsEnab | kPowerSoftConn, kPower);
+}
+
+void MtMusb::StartController(StartControllerCompleter::Sync& completer) {
+  fdf::info("mt-musb: StartController");
+  InitPhy();
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    InitCore();
+    running_ = true;
+  }
+  zx_status_t s = async::PostTask(irq_dispatcher_.async_dispatcher(), [this]() { IrqLoop(); });
+  if (s != ZX_OK) {
+    completer.Reply(zx::error(s));
+    return;
+  }
+  fdf::info("mt-musb: soft-connect on, POWER {:#x} DEVCTL {:#x}", usb().Read8(kPower),
+            usb().Read8(kDevCtl));
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::StopController(StopControllerCompleter::Sync& completer) {
+  SetConnected(false);
+  std::lock_guard<std::mutex> lock(hw_lock_);
+  usb().Write8(0, kPower);
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::IrqLoop() {
+  uint32_t logged = 0;
+  while (true) {
+    zx_status_t s = irq_.wait(nullptr);
+    if (s != ZX_OK) {
+      fdf::info("mt-musb: irq wait ended: {}", zx_status_get_string(s));
+      return;
+    }
+    uint32_t l1;
+    uint8_t usbint;
+    uint16_t tx, rx;
+    {
+      std::lock_guard<std::mutex> lock(hw_lock_);
+      auto& u = usb();
+      l1 = u.Read32(kL1Ints) & u.Read32(kL1IntM);
+      usbint = u.Read8(kIntrUsb) & u.Read8(kIntrUsbE);
+      tx = u.Read16(kIntrTx) & u.Read16(kIntrTxE);
+      rx = u.Read16(kIntrRx) & u.Read16(kIntrRxE);
+      // MediaTek: interrupt status is write-1-to-clear.
+      if (usbint) u.Write8(usbint, kIntrUsb);
+      if (tx) u.Write16(tx, kIntrTx);
+      if (rx) u.Write16(rx, kIntrRx);
+    }
+    if (logged < 12) {
+      logged++;
+      fdf::info("mt-musb: irq L1 {:#x} USB {:#x} TX {:#x} RX {:#x}", l1, usbint, tx, rx);
+    }
+    if (usbint & kUsbIntReset) {
+      HandleBusReset();
+    }
+    if (usbint & kUsbIntDiscon) {
+      fdf::info("mt-musb: disconnect");
+      SetConnected(false);
+    }
+    if (tx & 1) {
+      HandleEp0();
+    }
+    for (uint8_t i = 1; i < kNumEps; i++) {
+      if (tx & (1u << i)) {
+        HandleTx(i);
+      }
+      if (rx & (1u << i)) {
+        HandleRx(i);
+      }
+    }
+    irq_.ack();
+  }
+}
+
+void MtMusb::HandleBusReset() {
+  bool hs;
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    usb().Write8(0, kFaddr);
+    SelectEp(0);
+    ep0_state_ = Ep0State::kIdle;
+    pending_address_.reset();
+    hs = usb().Read8(kPower) & kPowerHsMode;
+  }
+  fdf::info("mt-musb: bus reset, {} speed", hs ? "high" : "full");
+  SetConnected(true);
+  if (dci_intf_.is_valid()) {
+    fidl::Arena arena;
+    auto r = dci_intf_.buffer(arena)->SetSpeed(hs ? fdescriptor::wire::UsbSpeed::kHigh
+                                                  : fdescriptor::wire::UsbSpeed::kFull);
+    if (!r.ok()) {
+      fdf::error("SetSpeed: {}", r.status_string());
+    }
+  }
+}
+
+void MtMusb::SetConnected(bool connected) {
+  if (connected_.exchange(connected) == connected) {
+    return;
+  }
+  if (dci_intf_.is_valid()) {
+    fidl::Arena arena;
+    auto r = dci_intf_.buffer(arena)->SetConnected(connected);
+    if (!r.ok()) {
+      fdf::error("SetConnected: {}", r.status_string());
+    }
+  }
+  if (!connected) {
+    for (uint8_t i = 1; i < kNumEps; i++) {
+      in_eps_[i]->FailAll(ZX_ERR_IO_NOT_PRESENT);
+      out_eps_[i]->FailAll(ZX_ERR_IO_NOT_PRESENT);
+    }
+  }
+}
+
+void MtMusb::HandleEp0() {
+  std::optional<fdescriptor::wire::UsbSetup> setup;
+  std::optional<std::pair<fdescriptor::wire::UsbSetup, std::vector<uint8_t>>> out_done;
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    auto& u = usb();
+    SelectEp(0);
+    uint16_t csr = u.Read16(kTxCsr);
+    if (csr & kCsr0SentStall) {
+      u.Write16(csr & ~kCsr0SentStall, kTxCsr);
+      ep0_state_ = Ep0State::kIdle;
+      csr = u.Read16(kTxCsr);
+    }
+    if (csr & kCsr0SetupEnd) {
+      u.Write16(kCsr0SvdSetupEnd, kTxCsr);
+      ep0_state_ = Ep0State::kIdle;
+      csr = u.Read16(kTxCsr);
+    }
+    switch (ep0_state_) {
+      case Ep0State::kStatus:
+        // The status stage of the previous transfer is done.
+        if (pending_address_) {
+          u.Write8(*pending_address_, kFaddr);
+          fdf::info("mt-musb: address {}", *pending_address_);
+          pending_address_.reset();
+        }
+        ep0_state_ = Ep0State::kIdle;
+        break;
+      case Ep0State::kDataIn:
+        if (!(csr & kCsr0TxPktRdy)) {
+          Ep0SendNext();
+        }
+        return;
+      case Ep0State::kDataOut:
+        if (csr & kCsr0RxPktRdy) {
+          const uint16_t count = u.Read16(kRxCount);
+          const size_t old = ep0_data_.size();
+          ep0_data_.resize(old + count);
+          FifoRead(0, ep0_data_.data() + old, count);
+          if (ep0_data_.size() >= ep0_setup_.w_length || count < kEp0MaxPacket) {
+            out_done.emplace(ep0_setup_, std::move(ep0_data_));
+            ep0_data_.clear();
+          } else {
+            u.Write16(kCsr0SvdRxPktRdy, kTxCsr);
+            return;
+          }
+        } else {
+          return;
+        }
+        break;
+      case Ep0State::kIdle:
+        break;
+    }
+    if (!out_done && ep0_state_ == Ep0State::kIdle && (csr & kCsr0RxPktRdy)) {
+      const uint16_t count = u.Read16(kRxCount);
+      if (count != sizeof(fdescriptor::wire::UsbSetup)) {
+        std::vector<uint8_t> junk(count);
+        FifoRead(0, junk.data(), count);
+        u.Write16(kCsr0SvdRxPktRdy | kCsr0SendStall, kTxCsr);
+        return;
+      }
+      uint8_t raw[8];
+      FifoRead(0, raw, sizeof(raw));
+      fdescriptor::wire::UsbSetup s;
+      s.bm_request_type = raw[0];
+      s.b_request = raw[1];
+      s.w_value = static_cast<uint16_t>(raw[2] | (raw[3] << 8));
+      s.w_index = static_cast<uint16_t>(raw[4] | (raw[5] << 8));
+      s.w_length = static_cast<uint16_t>(raw[6] | (raw[7] << 8));
+      ep0_setup_ = s;
+      setup = s;
+    }
+  }
+  if (out_done) {
+    std::vector<uint8_t> unused;
+    zx_status_t s = DoControl(out_done->first, out_done->second, &unused);
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    SelectEp(0);
+    if (s == ZX_OK) {
+      usb().Write16(kCsr0SvdRxPktRdy | kCsr0DataEnd, kTxCsr);
+      ep0_state_ = Ep0State::kStatus;
+    } else {
+      usb().Write16(kCsr0SvdRxPktRdy | kCsr0SendStall, kTxCsr);
+      ep0_state_ = Ep0State::kIdle;
+    }
+    return;
+  }
+  if (setup) {
+    HandleSetup(*setup);
+  }
+}
+
+void MtMusb::HandleSetup(const fdescriptor::wire::UsbSetup& setup) {
+  const bool is_in = setup.bm_request_type & 0x80;
+  const uint16_t len = setup.w_length;
+
+  if (setup.bm_request_type == 0x00 && setup.b_request == 0x05) {  // SET_ADDRESS
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    pending_address_ = static_cast<uint8_t>(setup.w_value & 0x7f);
+    SelectEp(0);
+    usb().Write16(kCsr0SvdRxPktRdy | kCsr0DataEnd, kTxCsr);
+    ep0_state_ = Ep0State::kStatus;
+    return;
+  }
+  if (!is_in && len > 0) {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    ep0_data_.clear();
+    SelectEp(0);
+    usb().Write16(kCsr0SvdRxPktRdy, kTxCsr);
+    ep0_state_ = Ep0State::kDataOut;
+    return;
+  }
+
+  std::vector<uint8_t> read;
+  zx_status_t s = DoControl(setup, {}, &read);
+  std::lock_guard<std::mutex> lock(hw_lock_);
+  SelectEp(0);
+  if (s != ZX_OK) {
+    usb().Write16(kCsr0SvdRxPktRdy | kCsr0SendStall, kTxCsr);
+    ep0_state_ = Ep0State::kIdle;
+    return;
+  }
+  if (is_in && len > 0) {
+    if (read.size() > len) {
+      read.resize(len);
+    }
+    ep0_data_ = std::move(read);
+    ep0_offset_ = 0;
+    usb().Write16(kCsr0SvdRxPktRdy, kTxCsr);
+    ep0_state_ = Ep0State::kDataIn;
+    Ep0SendNext();
+  } else {
+    usb().Write16(kCsr0SvdRxPktRdy | kCsr0DataEnd, kTxCsr);
+    ep0_state_ = Ep0State::kStatus;
+  }
+}
+
+void MtMusb::Ep0SendNext() {
+  const size_t remaining = ep0_data_.size() - ep0_offset_;
+  const size_t chunk = std::min<size_t>(remaining, kEp0MaxPacket);
+  FifoWrite(0, ep0_data_.data() + ep0_offset_, chunk);
+  ep0_offset_ += chunk;
+  const bool last = chunk < kEp0MaxPacket || ep0_offset_ >= ep0_setup_.w_length;
+  SelectEp(0);
+  usb().Write16(kCsr0TxPktRdy | (last ? kCsr0DataEnd : 0), kTxCsr);
+  if (last) {
+    ep0_state_ = Ep0State::kStatus;
+  }
+}
+
+zx_status_t MtMusb::DoControl(const fdescriptor::wire::UsbSetup& setup,
+                              const std::vector<uint8_t>& write, std::vector<uint8_t>* read) {
+  if (!dci_intf_.is_valid()) {
+    return ZX_ERR_BAD_STATE;
+  }
+  fidl::Arena arena;
+  fdescriptor::wire::UsbSetup wsetup = setup;
+  auto w = fidl::VectorView<uint8_t>::FromExternal(const_cast<uint8_t*>(write.data()), write.size());
+  auto result = dci_intf_.buffer(arena)->Control(wsetup, w);
+  if (!result.ok()) {
+    fdf::error("Control: {}", result.status_string());
+    return ZX_ERR_INTERNAL;
+  }
+  if (result->is_error()) {
+    return result->error_value();
+  }
+  auto data = result.value()->read.get();
+  read->assign(data.begin(), data.end());
+  return ZX_OK;
+}
+
+void MtMusb::FifoWrite(uint8_t ep_num, const uint8_t* data, size_t len) {
+  auto& u = usb();
+  size_t i = 0;
+  for (; i + 4 <= len; i += 4) {
+    uint32_t v;
+    memcpy(&v, data + i, 4);
+    u.Write32(v, Fifo(ep_num));
+  }
+  for (; i < len; i++) {
+    u.Write8(data[i], Fifo(ep_num));
+  }
+}
+
+void MtMusb::FifoRead(uint8_t ep_num, uint8_t* data, size_t len) {
+  auto& u = usb();
+  size_t i = 0;
+  for (; i + 4 <= len; i += 4) {
+    uint32_t v = u.Read32(Fifo(ep_num));
+    memcpy(data + i, &v, 4);
+  }
+  for (; i < len; i++) {
+    data[i] = u.Read8(Fifo(ep_num));
+  }
+}
+
+std::optional<std::pair<frequest::Request, size_t>> MtMusb::PumpTx(Endpoint* ep) {
+  if (!running_ || !ep->enabled) {
+    return std::nullopt;
+  }
+  auto& u = usb();
+  SelectEp(ep->ep_num());
+  const uint16_t csr = u.Read16(kTxCsr);
+  if (csr & kTxCsrTxPktRdy) {
+    return std::nullopt;  // previous packet still in the FIFO
+  }
+  if (ep->current && ep->offset >= ep->length && !ep->zlp_pending) {
+    std::pair<frequest::Request, size_t> done{std::move(*ep->current), ep->length};
+    ep->current.reset();
+    return done;
+  }
+  if (!ep->current) {
+    if (ep->queued.empty()) {
+      return std::nullopt;
+    }
+    ep->current = std::move(ep->queued.front());
+    ep->queued.pop();
+    if (!ep->Gather(*ep->current, ep->buf)) {
+      std::pair<frequest::Request, size_t> bad{std::move(*ep->current), SIZE_MAX};
+      ep->current.reset();
+      return bad;
+    }
+    ep->length = ep->buf.size();
+    ep->offset = 0;
+    ep->zlp_pending = (ep->length % ep->max_packet) == 0;
+  }
+  const size_t chunk = std::min<size_t>(ep->length - ep->offset, ep->max_packet);
+  FifoWrite(ep->ep_num(), ep->buf.data() + ep->offset, chunk);
+  ep->offset += chunk;
+  if (chunk < ep->max_packet) {
+    ep->zlp_pending = false;
+  }
+  SelectEp(ep->ep_num());
+  u.Write16(static_cast<uint16_t>((csr & ~(kTxCsrUnderRun | kTxCsrSentStall)) | kTxCsrTxPktRdy),
+            kTxCsr);
+  return std::nullopt;
+}
+
+std::optional<std::pair<frequest::Request, size_t>> MtMusb::PumpRx(Endpoint* ep) {
+  if (!running_ || !ep->enabled) {
+    return std::nullopt;
+  }
+  auto& u = usb();
+  SelectEp(ep->ep_num());
+  const uint16_t csr = u.Read16(kRxCsr);
+  if (!(csr & kRxCsrRxPktRdy)) {
+    return std::nullopt;
+  }
+  if (!ep->current) {
+    if (ep->queued.empty()) {
+      ep->rx_waiting = true;  // leave the packet in the FIFO until a request arrives
+      return std::nullopt;
+    }
+    ep->current = std::move(ep->queued.front());
+    ep->queued.pop();
+    ep->length = Endpoint::RequestLength(*ep->current);
+    ep->buf.clear();
+  }
+  ep->rx_waiting = false;
+  const uint16_t count = u.Read16(kRxCount);
+  const size_t room = ep->length - ep->buf.size();
+  const size_t keep = std::min<size_t>(count, room);
+  const size_t old = ep->buf.size();
+  ep->buf.resize(old + keep);
+  FifoRead(ep->ep_num(), ep->buf.data() + old, keep);
+  for (size_t i = keep; i < count; i++) {
+    (void)u.Read8(Fifo(ep->ep_num()));  // overflow: drop
+  }
+  SelectEp(ep->ep_num());
+  u.Write16(static_cast<uint16_t>(csr & ~(kRxCsrRxPktRdy | kRxCsrOverRun)), kRxCsr);
+  if (count < ep->max_packet || ep->buf.size() >= ep->length) {
+    const size_t actual = ep->buf.size();
+    if (!ep->Scatter(*ep->current, ep->buf)) {
+      std::pair<frequest::Request, size_t> bad{std::move(*ep->current), SIZE_MAX};
+      ep->current.reset();
+      return bad;
+    }
+    std::pair<frequest::Request, size_t> done{std::move(*ep->current), actual};
+    ep->current.reset();
+    return done;
+  }
+  return std::nullopt;
+}
+
+void MtMusb::HandleTx(uint8_t ep_num) { KickEndpoint(&*in_eps_[ep_num]); }
+
+void MtMusb::HandleRx(uint8_t ep_num) { KickEndpoint(&*out_eps_[ep_num]); }
+
+void MtMusb::KickEndpoint(Endpoint* ep) {
+  while (true) {
+    std::optional<std::pair<frequest::Request, size_t>> done;
+    {
+      std::lock_guard<std::mutex> lock(hw_lock_);
+      done = ep->is_in() ? PumpTx(ep) : PumpRx(ep);
+    }
+    if (!done) {
+      return;
+    }
+    if (done->second == SIZE_MAX) {
+      ep->Complete(std::move(done->first), ZX_ERR_INVALID_ARGS, 0);
+    } else {
+      ep->Complete(std::move(done->first), ZX_OK, done->second);
+    }
+  }
+}
+
+void MtMusb::CancelEndpoint(Endpoint* ep) {
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    if (running_ && ep->enabled) {
+      SelectEp(ep->ep_num());
+      if (ep->is_in()) {
+        usb().Write16(kTxCsrMode | kTxCsrFlushFifo, kTxCsr);
+      } else {
+        usb().Write16(kRxCsrFlushFifo, kRxCsr);
+      }
+    }
+  }
+  ep->FailAll(ZX_ERR_CANCELED);
+}
+
+Endpoint* MtMusb::LookupEp(uint8_t ep_addr) {
+  const uint8_t num = ep_addr & 0x0f;
+  if (num == 0 || num >= kNumEps) {
+    return nullptr;
+  }
+  return (ep_addr & 0x80) ? &*in_eps_[num] : &*out_eps_[num];
+}
+
+void MtMusb::ConnectToEndpoint(ConnectToEndpointRequest& request,
+                               ConnectToEndpointCompleter::Sync& completer) {
+  Endpoint* ep = LookupEp(request.ep_addr());
+  if (ep == nullptr) {
+    fdf::error("ConnectToEndpoint: bad address {:#x}", request.ep_addr());
+    completer.Reply(fit::as_error(ZX_ERR_IO_NOT_PRESENT));
+    return;
+  }
+  ep->Connect(dispatcher(), std::move(request.ep()));
+  completer.Reply(fit::ok());
+}
+
+void MtMusb::SetInterface(SetInterfaceRequest& request, SetInterfaceCompleter::Sync& completer) {
+  if (dci_intf_.is_valid()) {
+    completer.Reply(zx::error(ZX_ERR_ALREADY_BOUND));
+    return;
+  }
+  dci_intf_.Bind(std::move(request.interface()));
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::ConfigureEndpoint(ConfigureEndpointRequest& request,
+                               ConfigureEndpointCompleter::Sync& completer) {
+  const auto& desc = request.ep_descriptor();
+  Endpoint* ep = LookupEp(desc.b_endpoint_address());
+  if (ep == nullptr) {
+    completer.Reply(zx::error(ZX_ERR_INVALID_ARGS));
+    return;
+  }
+  const uint16_t maxp = desc.w_max_packet_size() & 0x7ff;
+  if (maxp == 0 || maxp > kFifoBytes) {
+    completer.Reply(zx::error(ZX_ERR_NOT_SUPPORTED));
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    auto& u = usb();
+    SelectEp(ep->ep_num());
+    if (ep->is_in()) {
+      u.Write16(maxp, kTxMaxP);
+      u.Write16(kTxCsrMode | kTxCsrClrDataTog | kTxCsrFlushFifo, kTxCsr);
+      u.Write16(kTxCsrMode | kTxCsrClrDataTog | kTxCsrFlushFifo, kTxCsr);
+      u.Write16(static_cast<uint16_t>(u.Read16(kIntrTxE) | (1u << ep->ep_num())), kIntrTxE);
+    } else {
+      u.Write16(maxp, kRxMaxP);
+      u.Write16(kRxCsrClrDataTog | kRxCsrFlushFifo, kRxCsr);
+      u.Write16(kRxCsrClrDataTog | kRxCsrFlushFifo, kRxCsr);
+      u.Write16(static_cast<uint16_t>(u.Read16(kIntrRxE) | (1u << ep->ep_num())), kIntrRxE);
+    }
+    ep->max_packet = maxp;
+    ep->type = desc.bm_attributes() & 0x3;
+    ep->enabled = true;
+  }
+  fdf::info("mt-musb: ep {:#x} configured, type {} maxp {}", desc.b_endpoint_address(),
+            desc.bm_attributes() & 0x3, maxp);
+  completer.Reply(zx::ok());
+  KickEndpoint(ep);
+}
+
+void MtMusb::DisableEndpoint(DisableEndpointRequest& request,
+                             DisableEndpointCompleter::Sync& completer) {
+  Endpoint* ep = LookupEp(request.ep_address());
+  if (ep == nullptr) {
+    completer.Reply(zx::error(ZX_ERR_INVALID_ARGS));
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(hw_lock_);
+    auto& u = usb();
+    if (ep->is_in()) {
+      u.Write16(static_cast<uint16_t>(u.Read16(kIntrTxE) & ~(1u << ep->ep_num())), kIntrTxE);
+    } else {
+      u.Write16(static_cast<uint16_t>(u.Read16(kIntrRxE) & ~(1u << ep->ep_num())), kIntrRxE);
+    }
+    ep->enabled = false;
+  }
+  ep->FailAll(ZX_ERR_IO_NOT_PRESENT);
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::EndpointSetStall(EndpointSetStallRequest& request,
+                              EndpointSetStallCompleter::Sync& completer) {
+  Endpoint* ep = LookupEp(request.ep_address());
+  if (ep == nullptr) {
+    completer.Reply(zx::error(ZX_ERR_INVALID_ARGS));
+    return;
+  }
+  std::lock_guard<std::mutex> lock(hw_lock_);
+  SelectEp(ep->ep_num());
+  if (ep->is_in()) {
+    usb().Write16(static_cast<uint16_t>(usb().Read16(kTxCsr) | kTxCsrSendStall), kTxCsr);
+  } else {
+    usb().Write16(static_cast<uint16_t>(usb().Read16(kRxCsr) | kRxCsrSendStall), kRxCsr);
+  }
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::EndpointClearStall(EndpointClearStallRequest& request,
+                                EndpointClearStallCompleter::Sync& completer) {
+  Endpoint* ep = LookupEp(request.ep_address());
+  if (ep == nullptr) {
+    completer.Reply(zx::error(ZX_ERR_INVALID_ARGS));
+    return;
+  }
+  std::lock_guard<std::mutex> lock(hw_lock_);
+  SelectEp(ep->ep_num());
+  if (ep->is_in()) {
+    uint16_t csr = usb().Read16(kTxCsr) & ~(kTxCsrSendStall | kTxCsrSentStall);
+    usb().Write16(static_cast<uint16_t>(csr | kTxCsrClrDataTog), kTxCsr);
+  } else {
+    uint16_t csr = usb().Read16(kRxCsr) & ~(kRxCsrSendStall | kRxCsrSentStall);
+    usb().Write16(static_cast<uint16_t>(csr | kRxCsrClrDataTog), kRxCsr);
+  }
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::CancelAll(CancelAllRequest& request, CancelAllCompleter::Sync& completer) {
+  Endpoint* ep = LookupEp(request.ep_address());
+  if (ep == nullptr) {
+    completer.Reply(zx::error(ZX_ERR_INVALID_ARGS));
+    return;
+  }
+  CancelEndpoint(ep);
+  completer.Reply(zx::ok());
+}
+
+void MtMusb::GetHardwareInfo(GetHardwareInfoCompleter::Sync& completer) {
+  // usb-peripheral then falls back to legacy (sequential) endpoint allocation,
+  // which hands out 0x01.. and 0x81.. -- all within kNumEps.
+  completer.Reply(zx::error(ZX_ERR_NOT_SUPPORTED));
+}
+
+void MtMusb::AllocEndpoint(AllocEndpointRequest& request,
+                           AllocEndpointCompleter::Sync& completer) {
+  completer.Reply(zx::error(ZX_ERR_NOT_SUPPORTED));
+}
+
+void MtMusb::FreeEndpoint(FreeEndpointRequest& request, FreeEndpointCompleter::Sync& completer) {
+  completer.Reply(zx::error(ZX_ERR_NOT_SUPPORTED));
+}
