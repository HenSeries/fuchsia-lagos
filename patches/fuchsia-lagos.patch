@@ -0,0 +1,1114 @@
+// Copyright 2026 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/devices/usb/drivers/mt-musb/mt-musb.h"
+
+#include <fidl/fuchsia.hardware.platform.device/cpp/fidl.h>
+#include <lib/async/cpp/task.h>
+#include <lib/driver/component/cpp/driver_export2.h>
+#include <lib/driver/component/cpp/node_add_args.h>
+#include <lib/driver/logging/cpp/logger.h>
+#include <lib/zx/time.h>
+#include <lib/zx/vmar.h>
+#include <zircon/status.h>
+
+#include <algorithm>
+#include <cstring>
+
+#include <bind/fuchsia/cpp/bind.h>
+#include <bind/fuchsia/mediatek/platform/cpp/bind.h>
+
+namespace mt_musb {
+
+namespace {
+
+// ---- MUSB core (MMIO 0 = 0x11200000) ----
+constexpr uint32_t kFaddr = 0x00;     // 8
+constexpr uint32_t kPower = 0x01;     // 8
+constexpr uint32_t kIntrTx = 0x02;    // 16, W1C on MediaTek
+constexpr uint32_t kIntrRx = 0x04;    // 16, W1C
+constexpr uint32_t kIntrTxE = 0x06;   // 16
+constexpr uint32_t kIntrRxE = 0x08;   // 16
+constexpr uint32_t kIntrUsb = 0x0a;   // 8, W1C
+constexpr uint32_t kIntrUsbE = 0x0b;  // 8
+constexpr uint32_t kIndex = 0x0e;     // 8
+// Indexed endpoint registers (select with kIndex first).
+constexpr uint32_t kTxMaxP = 0x10;   // 16
+constexpr uint32_t kTxCsr = 0x12;    // 16 (CSR0 for ep0)
+constexpr uint32_t kRxMaxP = 0x14;   // 16
+constexpr uint32_t kRxCsr = 0x16;    // 16
+constexpr uint32_t kRxCount = 0x18;  // 16 (COUNT0 for ep0)
+constexpr uint32_t kDevCtl = 0x60;     // 8
+constexpr uint32_t kTxFifoSz = 0x62;   // 8, indexed
+constexpr uint32_t kRxFifoSz = 0x63;   // 8, indexed
+constexpr uint32_t kTxFifoAdd = 0x64;  // 16, indexed, 8-byte units
+constexpr uint32_t kRxFifoAdd = 0x66;  // 16, indexed
+constexpr uint32_t kHwVers = 0x6c;     // 16
+constexpr uint32_t kEpInfo = 0x78;     // 8
+constexpr uint32_t kRamInfo = 0x79;    // 8
+constexpr uint32_t kRxTogEn = 0x82;    // 16
+constexpr uint32_t kTxTogEn = 0x86;    // 16
+constexpr uint32_t kL1Ints = 0xa0;     // 32
+constexpr uint32_t kL1IntM = 0xa4;     // 32
+constexpr uint32_t Fifo(uint8_t ep) { return 0x20 + 4u * ep; }
+
+constexpr uint8_t kPowerEnSuspend = 0x01;
+constexpr uint8_t kPowerReset = 0x08;
+constexpr uint8_t kPowerHsMode = 0x10;
+constexpr uint8_t kPowerHsEnab = 0x20;
+constexpr uint8_t kPowerSoftConn = 0x40;
+
+constexpr uint8_t kUsbIntSuspend = 0x01;
+constexpr uint8_t kUsbIntResume = 0x02;
+constexpr uint8_t kUsbIntReset = 0x04;
+constexpr uint8_t kUsbIntDiscon = 0x20;
+
+constexpr uint32_t kL1Tx = 1u << 0;
+constexpr uint32_t kL1Rx = 1u << 1;
+constexpr uint32_t kL1UsbCom = 1u << 2;
+
+// CSR0 (peripheral).
+constexpr uint16_t kCsr0RxPktRdy = 0x0001;
+constexpr uint16_t kCsr0TxPktRdy = 0x0002;
+constexpr uint16_t kCsr0SentStall = 0x0004;
+constexpr uint16_t kCsr0DataEnd = 0x0008;
+constexpr uint16_t kCsr0SetupEnd = 0x0010;
+constexpr uint16_t kCsr0SendStall = 0x0020;
+constexpr uint16_t kCsr0SvdRxPktRdy = 0x0040;
+constexpr uint16_t kCsr0SvdSetupEnd = 0x0080;
+
+// TXCSR (peripheral).
+constexpr uint16_t kTxCsrTxPktRdy = 0x0001;
+constexpr uint16_t kTxCsrUnderRun = 0x0004;
+constexpr uint16_t kTxCsrFlushFifo = 0x0008;
+constexpr uint16_t kTxCsrSendStall = 0x0010;
+constexpr uint16_t kTxCsrSentStall = 0x0020;
+constexpr uint16_t kTxCsrClrDataTog = 0x0040;
+constexpr uint16_t kTxCsrMode = 0x2000;
+
+// RXCSR (peripheral).
+constexpr uint16_t kRxCsrRxPktRdy = 0x0001;
+constexpr uint16_t kRxCsrOverRun = 0x0004;
+constexpr uint16_t kRxCsrFlushFifo = 0x0010;
+constexpr uint16_t kRxCsrSendStall = 0x0020;
+constexpr uint16_t kRxCsrSentStall = 0x0040;
+constexpr uint16_t kRxCsrClrDataTog = 0x0080;
+
+// ---- U2 PHY (MMIO 1 = 0x11cc0000, port 0 at +0x800) ----
+constexpr uint32_t kPhy = 0x800;
+constexpr uint32_t kUsbPhyAcr1 = kPhy + 0x04;
+constexpr uint32_t kUsbPhyAcr5 = kPhy + 0x14;
+constexpr uint32_t kUsbPhyAcr6 = kPhy + 0x18;
+constexpr uint32_t kUsbPhyAcr3 = kPhy + 0x1c;
+constexpr uint32_t kU2PhyAcr4 = kPhy + 0x20;
+constexpr uint32_t kU2PhyDtm0 = kPhy + 0x68;
+constexpr uint32_t kU2PhyDtm1 = kPhy + 0x6c;
+
+// ---- Clocks (MMIO 2 = infracfg_ao 0x10001000, MMIO 3 = topckgen 0x10000000) ----
+constexpr uint32_t kInfraCg0Clr = 0x84;
+constexpr uint32_t kInfraCg0Sta = 0x90;
+constexpr uint32_t kIcUsbBit = 1u << 8;
+constexpr uint32_t kTopClkCfgUpdate = 0x04;
+constexpr uint32_t kTopClkCfg5 = 0x90;
+constexpr uint32_t kTopClkCfg5Set = 0x94;
+constexpr uint32_t kTopClkCfg5Clr = 0x98;
+
+uint8_t FifoSizeCode(uint16_t bytes) {
+  // Size is 2^(code + 3) bytes.
+  uint8_t code = 0;
+  while ((8u << code) < bytes) {
+    code++;
+  }
+  return code;
+}
